# このファイルを .env にコピーして使う。.env は Git に入らない。
# Notion の内部インテグレーションのトークン（読み取り専用で作る）。ソースコードには書かない。
NOTION_TOKEN=
# 議事録のデータベース ID（HiDock記録など）。空なら取り込みは動かない。
NOTION_DATABASE_ID=
# プロジェクト名・会議日を読むプロパティ名（Notion 側の列名）
NOTION_PROJECT_PROPERTY=関連プロジェクト
NOTION_DATE_PROPERTY=録音日時
# SQLite の場所（既定 data/pmo.db）
PMO_DB_PATH=data/pmo.db
# ここに ANTHROPIC_API_KEY は絶対に書かない（書くと API 従量課金になる）
# Notion のデータベースが試験用なら test と書く（書かなければ本物＝実データ扱いで、設定で許可するまで読まない）
NOTION_DATABASE_KIND=test
# 実データ（設定の「実データを扱う」を 1 にするまで使われない）
# ドライブの PMO ナレッジを PC に書き出したフォルダ（.md / .txt）
KNOWLEDGE_DIR=
# note の公式の書き出し（XML）の置き場所
NOTE_EXPORT_PATH=
